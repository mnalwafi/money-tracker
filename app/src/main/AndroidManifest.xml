<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <application
        android:name=".Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Buckwheat.Starting"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <service
            android:name=".service.ExpenseNotificationListenerService"
            android:label="@string/notification_capture_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.ExpenseActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.danilkinkin.buckwheat.ACTION_CONFIRM_EXPENSE" />
                <action android:name="com.danilkinkin.buckwheat.ACTION_DISMISS_EXPENSE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.RecurringActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.danilkinkin.buckwheat.ACTION_CONFIRM_RECURRING" />
                <action android:name="com.danilkinkin.buckwheat.ACTION_SKIP_RECURRING" />
                <action android:name="com.danilkinkin.buckwheat.ACTION_DISMISS_RECURRING" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".widget.extend.ExtendWidgetReceiver"
            android:label="@string/app_widget_extend_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/extend_app_widget_provider" />
        </receiver>

        <receiver
            android:name=".widget.minimal.MinimalWidgetReceiver"
            android:label="@string/app_widget_minimal_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/minimal_app_widget_provider" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>